{
  "name": "@indizio/puzzle",
  "version": "2.0.0",
  "description": "Generator und Löser für Krimi-Deduktionsrätsel: eine Person je Zeile und Spalte, ein wahrer Hinweis je Karte, garantiert eindeutig und ohne Raten lösbar.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "puzzle",
    "generator",
    "solver",
    "deduction",
    "logic-puzzle",
    "constraint"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:deep": "vitest run",
    "reference": "tsx scripts/write-reference.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.2",
    "i18next": "^24.2.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "i18next": ">=23"
  },
  "peerDependenciesMeta": {
    "i18next": {
      "optional": true
    }
  }
}
