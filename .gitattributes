# Line endings: always LF in the repo, whatever the system likes in the work tree.
#
# Without this file, what lands in the repo depends on every machine's
# `core.autocrlf`. Files written on Windows arrived with CRLF; checked out on
# macOS or Linux they came back that way, and the next change looked as if the
# whole file had been rewritten.
* text=auto eol=lf

# Windows scripts need CRLF, or the command prompt will not run them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary: do not touch, merge or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary

# SVG is text and should stay readable in a diff — the game's drawings are
# source, not image material.
*.svg text

# Written by tools: collapsed in diffs so changes there do not hide the real work.
package-lock.json linguist-generated=true -diff
tests/engine/reference/* linguist-generated=true
src/**/*.module.d.css.ts linguist-generated=true

# GitHub should classify the project by its game code, not its drawings.
art/** linguist-vendored=true
