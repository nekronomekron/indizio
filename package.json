{
  "name": "indizio",
  "private": true,
  "version": "2026.5",
  "type": "module",
  "description": "Indizio — Logikrätsel am Tatort",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekronomekron/indizio.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.engine.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project engine --project app",
    "test:watch": "vitest --project engine --project app",
    "test:deep": "vitest run --project deep",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "reference": "tsx scripts/write-reference.ts",
    "art": "tsx scripts/build-art.ts",
    "art:sheet": "tsx scripts/art-sheet.ts",
    "bump": "tsx scripts/bump-version.ts"
  },
  "dependencies": {
    "i18next": "^24.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
