{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "strict": true,
    // Gemessen und dann eingeschaltet: streng kostete genau einen Handgriff,
    // und ohne den Schalter erklaerte der Linter jedes defensive `!` auf einem
    // Feldzugriff fuer unnoetig - ein Rat, der den Code an dem Tag falsch
    // machen wuerde, an dem hier doch "true" steht.
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@engine": [
        "src/engine/index.ts"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@engine/i18n": [
        "src/engine/i18n/index.ts"
      ]
    }
  },
  // Die Engine hat ihre eigene, strengere Konfiguration. Hier ist sie
  // ausgeschlossen, damit jede Datei genau einem Projekt gehoert - sonst
  // pruefte der Linter Engine-Dateien unter den laxeren Schaltern der App.
  "exclude": [
    "src/engine",
    "tests/engine"
  ],
  "include": [
    "src",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
